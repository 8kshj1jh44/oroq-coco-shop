# PostgreSQL connection string (Supabase session pooler with SSL)
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Payload CMS secret - use a long random string
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET

# Public URL of the storefront
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
